---
import Layout from '../layouts/Layout.astro';
import Search from '../islands/Search.tsx';
import ReaderTools from '../islands/ReaderTools.tsx';
import AudioPlayer from '../islands/AudioPlayer.tsx';
import SurahList from './SurahList.astro';
import { surahs, tafseerOn, audioOn, dev } from '../lib/data';
import { t, homePath, indexPath, surahPath, tafseerPath, type Lang } from '../../core/strings.ts';
import type { Surah } from '../../core/source-adapter.ts';
interface Props { surah: Surah; lang: Lang }
const { surah, lang } = Astro.props;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const last = surahs.length;
const prev = surah.n > 1 ? surahPath(lang, surah.n - 1) : null;
const next = surah.n < last ? surahPath(lang, surah.n + 1) : null;
const name = lang === 'ar' ? surah.ar : surah.en;
---
<Layout lang={lang} title={`${surah.n}. ${name} - ${t(lang, 'siteName')}`} alt={surahPath(other, surah.n)} wide>
  <div class="reader-grid">
  <div class="reader-main">
  <nav class="surah-nav" aria-label={t(lang, 'navLabel')}>
    <a href={homePath(lang)}>{t(lang, 'home')}</a>
    <a href={indexPath(lang)} data-index-link>{t(lang, 'surahIndex')}</a>
    {prev && <a rel="prev" data-prev href={prev}>{t(lang, 'prevSurah')}</a>}
    {next && <a rel="next" data-next href={next}>{t(lang, 'nextSurah')}</a>}
  </nav>
  <h1 class="surah-title"><bdi dir={lang === 'ar' ? 'rtl' : 'ltr'} data-sn>{surah.n}.</bdi>{' '}<span lang={lang === 'ar' ? 'ar' : 'en'}>{name}</span></h1>
  <details class="reader-search" data-reader-search>
    <summary class="btn" data-search-toggle>{t(lang, 'searchOpen')}</summary>
    <Search lang={lang} client:idle />
  </details>
  <ReaderTools lang={lang} s={surah.n} count={surah.items.length} client:idle />
  <ol class="ayat" aria-label={t(lang, 'ayatLabel')} data-surah={surah.n}>
    {surah.items.map((a) => (
      <li class="ayah-row" id={`a${a.aya_no}`} data-s={a.sora} data-a={a.aya_no}>
        <p class="ayah" lang="ar" dir="rtl" data-r={`${a.sora}:${a.aya_no}`}>{a.aya_text}</p>
        {audioOn && <button type="button" class="ap" data-ap={a.aya_no} aria-pressed="false" aria-label={t(lang, 'audioPlayAyah', { a: a.aya_no })} data-pending tabindex="-1">
          <svg class="ap-play" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12-7.5z" fill="currentColor" /></svg><svg class="ap-pause" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" /></svg>
        </button>}
        <button type="button" class="bm" data-a={a.aya_no} aria-pressed="false" aria-label={t(lang, 'bookmarkOff', { a: a.aya_no })} data-pending tabindex="-1">
          <span aria-hidden="true" class="bm-off">&#9734;</span><span aria-hidden="true" class="bm-on">&#9733;</span>
        </button>
        {tafseerOn && <a class="tf-link" href={tafseerPath(lang, a.sora, a.aya_no)} aria-label={t(lang, 'tafseerOf', { a: a.aya_no })} data-tf-link>{t(lang, 'tafseerShort')}</a>}
      </li>
    ))}
  </ol>
  {audioOn && <div class="player" data-player>
    {/* RQ-006: the player keeps its space before it loads (AC49), and without JavaScript only a
        short note shows (AC48). */}
    <noscript><p class="msg" data-audio-noscript>{t(lang, 'audioNoScript')}</p></noscript>
    <AudioPlayer lang={lang} s={surah.n} count={surah.items.length} name={name} dev={dev} client:idle />
  </div>}
  <nav class="surah-nav surah-nav-end" aria-label={t(lang, 'navLabel')}>
    {prev && <a rel="prev" href={prev}>{t(lang, 'prevSurah')}</a>}
    {next && <a rel="next" class="next-btn" href={next}>{t(lang, 'nextSurah')}</a>}
  </nav>
  </div>
  {/* Tablet and desktop widths (mockups): the surah index beside the text, current surah marked.
      Hidden at phone width, where the index link above is used. It comes after the text in reading
      and tab order. */}
  <aside class="reader-side" aria-label={t(lang, 'surahIndex')} data-reader-side>
    <SurahList lang={lang} label={t(lang, 'indexListLabel', { n: last })} current={surah.n} side />
  </aside>
  </div>
</Layout>
