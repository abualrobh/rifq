---
import Layout from '../layouts/Layout.astro';
import ReaderTools from '../islands/ReaderTools.tsx';
import AudioPlayer from '../islands/AudioPlayer.tsx';
import AyahPanels from '../islands/AyahPanels.tsx';
import Tips from '../islands/Tips.tsx';
import SurahList from './SurahList.astro';
import { surahs, tafseerOn, audioOn, dev, juz, juzByStartsOk, pagesOn, pageStarts } from '../lib/data';
import { mushafHash, mushafPath, pageOf, surahPageRuns } from '../../core/mushaf.ts';
import { t, surahPath, ayatLabel, type Lang } from '../../core/strings.ts';
import { splitAyahNumber } from '../../core/ayah-number.ts';
import type { Surah } from '../../core/source-adapter.ts';
interface Props { surah: Surah; lang: Lang }
const { surah, lang } = Astro.props;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const last = surahs.length;
const prev = surah.n > 1 ? surahPath(lang, surah.n - 1) : null;
const next = surah.n < last ? surahPath(lang, surah.n + 1) : null;
const name = lang === 'ar' ? surah.ar : surah.en;
const prevCount = surah.n > 1 ? surahs[surah.n - 2].items.length : 0;
// AC50 (P-19): the header line "Surah {s} · {n} ayat · Juz {j}", with the juz of the surah's first
// ayah in the file, as on index rows (D-090 D); without a juz in the file the line ends at the count.
const j0 = surah.items[0]?.jozz;
const meta = Number.isInteger(j0) ? t(lang, 'surahMeta', { s: surah.n, n: ayatLabel(lang, surah.items.length), j: j0 as number }) : t(lang, 'gotoSurahSub', { s: surah.n, n: ayatLabel(lang, surah.items.length) });
// Kit v43 (RQ-009 AC2, AC5): with page mode built, the header's view switch opens the Mushaf page of
// the surah's first ayah (the page script moves it to the reading place on a tap), and the page of
// each ayah goes to the early script as runs.
const view = pagesOn ? { to: 'pages' as const, href: mushafPath(lang, pageOf(pageStarts, surah.n, 1)) + mushafHash(surah.n, 1) } : undefined;
const pageRuns = pagesOn ? surahPageRuns(surah.items) : undefined;
---
<Layout lang={lang} title={`${surah.n}. ${name} - ${t(lang, 'siteName')}`} alt={surahPath(other, surah.n)} wide tab="read" textSize reader={{ s: surah.n, name, meta, view, pageRuns }}>
  <div class="reader-grid">
  <div class="reader-main">
  {/* Kit v39 (RQ-008 stage 3, AC50, AC58): the reader's header (layout) holds Back, the surah name
      (the page heading), its line, Go to and text size. The top links of kit v38 (home, surah index,
      previous and next surah) and the search button are gone: the tab bar, the home "All surahs"
      link, the Go to screen and the previous and next surah links at the end of the surah replace
      them (AC58). */}
  {/* RQ-008 AC51 (kit v38, D-203 A): the Play surah row and the reciter button at the top of the
      surah, below its title. It scrolls with the page: no recitation panel is fixed on screen; the
      mini-player above the tab bar is the only player (AC55). Its space is kept before it loads
      (RQ-006 AC49), and without JavaScript only a short note shows (AC48). */}
  {audioOn && <div class="surah-audio" data-surah-audio>
    <noscript><p class="msg" data-audio-noscript>{t(lang, 'audioNoScript')}</p></noscript>
    <AudioPlayer lang={lang} s={surah.n} count={surah.items.length} names={{ ar: surah.ar, en: surah.en }} dev={dev} client:idle />
  </div>}
  <ReaderTools lang={lang} s={surah.n} count={surah.items.length} client:idle />
  <ol class="ayat" aria-label={t(lang, 'ayatLabel')} data-surah={surah.n}>
    {surah.items.map((a) => (
      <li class="ayah-row" id={`a${a.aya_no}`} data-s={a.sora} data-a={a.aya_no}>
        {/* RQ-008 D-186 B (AC98 to AC107, P-23): the stored number, the digits after the last no-break
            space of aya_text, is wrapped in one element that the CSS draws the Mushaf-style
            end-of-ayah ornament on. The no-break space stays outside it, so the last word and the
            ornament never part. The element's text content is the stored text byte for byte (AC99):
            nothing is added, removed or changed; the digits stay real text in the Quran font, read
            once by screen readers (AC100, AC101). An ayah not ending that way is shown as stored,
            with no ornament (AC107; the build lists it). */}
        {(() => { const x = splitAyahNumber(a.aya_text); return x
          ? <p class="ayah" lang="ar" dir="rtl" data-r={`${a.sora}:${a.aya_no}`}>{x.head}<span class="ayah-no">{x.no}</span></p>
          : <p class="ayah" lang="ar" dir="rtl" data-r={`${a.sora}:${a.aya_no}`}>{a.aya_text}</p>; })()}
        {/* RQ-008 AC26 (kit v38, D-187 A): one actions button per ayah replaces the four per-ayah
            controls of kit v37 (play, play from here, bookmark, Tafseer link); they are in the ayah
            actions panel (islands/AyahPanels.tsx), which a tap on the ayah also opens. 44 px target,
            hidden with its space kept until the panel island loads, so without JavaScript no dead
            control shows. A bookmarked ayah gets its mark here (AC31). */}
        <div class="ayah-tools"><button type="button" class="ayah-act" data-act={a.aya_no} aria-label={t(lang, 'ayahActions', { a: a.aya_no })} aria-haspopup="dialog" data-pending tabindex="-1"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="5" r="2" fill="currentColor"/><circle cx="12" cy="12" r="2" fill="currentColor"/><circle cx="12" cy="19" r="2" fill="currentColor"/></svg></button></div>
      </li>
    ))}
  </ol>
  <AyahPanels lang={lang} s={surah.n} count={surah.items.length} names={{ ar: surah.ar, en: surah.en }} prevCount={prevCount} last={last} juz={juz} juzOk={juzByStartsOk} tafseer={tafseerOn} audio={audioOn} dev={dev} client:idle />
  {/* RQ-008 stage 4 (kit v40, AC79 to AC85): the first-visit tips; nothing in the static HTML. */}
  <Tips lang={lang} audio={audioOn} tafseer={tafseerOn} client:idle />
  <nav class="surah-nav surah-nav-end" aria-label={t(lang, 'navLabel')}>
    {prev && <a rel="prev" data-prev href={prev}>{t(lang, 'prevSurah')}</a>}
    {next && <a rel="next" data-next class="next-btn" href={next}>{t(lang, 'nextSurah')}</a>}
  </nav>
  </div>
  {/* Tablet and desktop widths (mockups): the surah index beside the text, current surah marked.
      Hidden at phone width, where the index link above is used. It comes after the text in reading
      and tab order. */}
  <aside class="reader-side" aria-label={t(lang, 'surahIndex')} data-reader-side>
    <SurahList lang={lang} label={t(lang, 'indexListLabel', { n: last })} current={surah.n} side />
  </aside>
  </div>
</Layout>
