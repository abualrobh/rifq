---
// RQ-004 surah index page (DRAFT v0.1). D-089 B: its own page, linked from the home page and every
// reader page. D-090 D: each row shows the juz the surah starts in, and a list of the 30 juz opens
// the reader at each juz's first ayah. D-091 B: the English-interface filter also matches English
// names. D-092 B: names also match from just after the article. D-094 B: English rows also show the
// Arabic name.
import Layout from '../layouts/Layout.astro';
import SurahList from './SurahList.astro';
import IndexFilter from '../islands/IndexFilter.tsx';
import Continue from '../islands/Continue.tsx';
import { surahs, counts, names, juz } from '../lib/data';
import { foldName, enKeys } from '../../core/surah-match.ts';
import { t, indexPath, ayahPath, type Lang } from '../../core/strings.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
// The search form of each Arabic name, built from the source at build time, as the Worker builds it
// for search offers (index 0 unused). Used for matching only, never displayed.
const folded = ['', ...surahs.map((s) => foldName(s.ar))];
// D-091 B: English match keys, for the English interface only (the Arabic interface keeps the
// D-050 Arabic-only message for Latin letters).
const en = lang === 'en' ? [['', ''] as [string, string], ...surahs.map((s) => enKeys(s.en))] : undefined;
---
<Layout lang={lang} title={`${t(lang, 'surahIndex')} - ${t(lang, 'siteName')}`} alt={indexPath(other)} wide>
  <h1 class="home-title">{t(lang, 'surahIndex')}</h1>
  <Continue lang={lang} counts={counts} names={names} client:idle />
  <IndexFilter lang={lang} folded={folded} en={en} counts={counts} names={names} client:idle />
  <SurahList lang={lang} id="surah-list" label={t(lang, 'indexListLabel', { n: surahs.length })} />
  <!-- D-090 D (AC23): the 30 juz by number, each opening the reader at its first ayah in the file. -->
  <section class="juz" aria-labelledby="juz-h" data-juz-list>
    <h2 id="juz-h">{t(lang, 'juzTitle')}</h2>
    <ol class="juz-list" aria-label={t(lang, 'juzListLabel', { n: juz.length })}>
      {juz.map((j) => (
        <li><a href={ayahPath(lang, j.s, j.a)} data-juz-link={j.juz} data-juz-start={`${j.s}:${j.a}`}>{t(lang, 'juzOf', { n: j.juz })}</a></li>
      ))}
    </ol>
  </section>
</Layout>
