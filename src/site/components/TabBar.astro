---
// RQ-008 AC1 to AC8 (kit v37): the five main items, Home, Read, Search, Saved, Settings, in this
// order in the reading direction (Home on the right in Arabic). Plain links that work without
// JavaScript (AC4). The layout renders this twice: as a bar at the bottom of the screen below 52rem
// (AC1) and as a row in the top header from 52rem (D-179 A, AC8). CSS shows one of the two at each
// width (display: none hides the other from screen readers too), so there is one landmark at a time.
// Read (D-180 A, AC3): the link opens the surah index; client/tabbar.ts points it at the last
// reading position when one is saved on the device and is in this build's source.
// Current item (AC2): aria-current="page" plus a cue that is not colour alone (bold label and an
// indicator bar). No item is current on the privacy and 404 pages.
import { t, homePath, indexPath, searchPath, savedPath, settingsPath, type Lang } from '../../core/strings.ts';
import { counts } from '../lib/data';
export type Tab = 'home' | 'read' | 'search' | 'saved' | 'settings';
interface Props { lang: Lang; tab?: Tab; variant: 'top' | 'bottom' }
const { lang, tab, variant } = Astro.props;
const items: { id: Tab; href: string; key: 'tabHome' | 'tabRead' | 'searchButton' | 'tabSaved' | 'tabSettings' }[] = [
  { id: 'home', href: homePath(lang), key: 'tabHome' },
  { id: 'read', href: indexPath(lang), key: 'tabRead' },
  { id: 'search', href: searchPath(lang), key: 'searchButton' },
  { id: 'saved', href: savedPath(lang), key: 'tabSaved' },
  { id: 'settings', href: settingsPath(lang), key: 'tabSettings' },
];
---
<nav class={`tabbar tabbar-${variant}`} aria-label={t(lang, 'tabBarLabel')} data-tabbar={variant} data-lang={lang} data-counts={counts.slice(1).join(',')}>
  <ul>
    {items.map((it) => (
      <li>
        <a href={it.href} data-tab={it.id} aria-current={tab === it.id ? 'page' : undefined}>
          {it.id === 'home' && <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>}
          {it.id === 'read' && <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 5h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2zM22 5h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>}
          {it.id === 'search' && <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>}
          {it.id === 'saved' && <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h12v18l-6-4-6 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>}
          {it.id === 'settings' && <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>}
          <span class="tab-label">{t(lang, it.key)}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
