---
// RQ-008 Search tab (kit v37). Kit v39 (stage 3): the Go to view (AC59 to AC69), also opened by the
// reader's Go to button (AC50) and shown under the home box (AC10).
import Layout from '../layouts/Layout.astro';
import GoTo from '../islands/GoTo.tsx';
import { counts, names, juz, juzByStartsOk, gotoFolded, gotoEn } from '../lib/data';
import { t, searchPath, type Lang } from '../../core/strings.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
---
<Layout lang={lang} title={`${t(lang, 'searchOpen')} - ${t(lang, 'siteName')}`} alt={searchPath(other)} tab="search">
  <h1 class="home-title">{t(lang, 'searchOpen')}</h1>
  <GoTo lang={lang} folded={gotoFolded} en={lang === 'en' ? gotoEn : undefined} counts={counts} names={names} juz={juz} juzOk={juzByStartsOk} client:idle />
</Layout>
