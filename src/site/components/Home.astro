---
// Home page. D-089 B: the surah list moved to its own index page (RQ-004); home keeps search and
// continue reading (RQ-003), with a clear link to the index.
import Layout from '../layouts/Layout.astro';
import Search from '../islands/Search.tsx';
import Saved from '../islands/Saved.tsx';
import { surahs, counts, names } from '../lib/data';
import { t, homePath, indexPath, type Lang } from '../../core/strings.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
---
<Layout lang={lang} title={t(lang, 'siteName')} alt={homePath(other)} wide>
  <h1 class="home-title">{t(lang, 'siteName')}</h1>
  <div class="home-grid">
    <div class="home-main">
      <Search lang={lang} client:idle />
      <p class="index-card-wrap"><a class="index-card" href={indexPath(lang)} data-index-link><span class="index-card-title">{t(lang, 'surahIndex')}</span> <span class="index-card-sub">{t(lang, 'indexListLabel', { n: surahs.length })}</span></a></p>
    </div>
    <div class="home-side">
      <Saved lang={lang} counts={counts} names={names} client:idle />
    </div>
  </div>
</Layout>
