---
// Home page. RQ-008 stage 1 (kit v37, AC9): from top to bottom, the brand (page title), the go-to
// box, the continue-reading card (when there is a last position), the mySaved row, the juz grid
// with an "All surahs" link, and the recently read row (when there is something to show).
// Go-to box (kit v39, RQ-008 stage 3, AC10, P-3): the Go to view of the Search screen (AC59 to AC69),
// with its direct results shown under the box as the reader types; word search only when asked.
// D-089: home keeps search.
// The bookmark list, Remove, Clear all and clear last position moved to the Saved screen (AC22).
import Layout from '../layouts/Layout.astro';
import GoTo from '../islands/GoTo.tsx';
import HomeSaved from '../islands/HomeSaved.tsx';
import HomeRecent from '../islands/HomeRecent.tsx';
import { counts, names, juz, juzByStartsOk, gotoFolded, gotoEn } from '../lib/data';
import { t, homePath, indexPath, ayahPath, type Lang } from '../../core/strings.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
---
<Layout lang={lang} title={t(lang, 'siteName')} alt={homePath(other)} wide tab="home">
  <div class="home">
    <h1 class="home-title">{t(lang, 'siteName')}</h1>
    <div class="home-goto" data-home-goto>
      <GoTo lang={lang} folded={gotoFolded} en={lang === 'en' ? gotoEn : undefined} counts={counts} names={names} juz={juz} juzOk={juzByStartsOk} home client:idle />
    </div>
    <HomeSaved lang={lang} counts={counts} names={names} juz={juz} juzOk={juzByStartsOk} client:idle />
    <!-- AC17 (D-090 D): the 30 juz, each opening the reader at its first ayah in the file, the same
         targets as the index page's juz list. AC18: "All surahs" opens the surah index. -->
    <section class="home-sec" aria-labelledby="home-juz-h" data-home-juz>
      <div class="home-sec-head">
        <h2 id="home-juz-h">{t(lang, 'juzTitle')}</h2>
        <a href={indexPath(lang)} data-index-link data-all-surahs>{t(lang, 'allSurahs')}</a>
      </div>
      <ol class="juz-grid" aria-label={t(lang, 'juzListLabel', { n: juz.length })}>
        {juz.map((j) => (
          <li><a href={ayahPath(lang, j.s, j.a)} aria-label={t(lang, 'juzOf', { n: j.juz })} data-home-juz-link={j.juz} data-juz-start={`${j.s}:${j.a}`}>{j.juz}</a></li>
        ))}
      </ol>
    </section>
    <HomeRecent lang={lang} counts={counts} names={names} client:idle />
  </div>
</Layout>
