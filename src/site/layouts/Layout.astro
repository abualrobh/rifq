---
// Every page uses this layout, so every page shows the source details (RQ-001 AC6) and, in
// development mode, the unverified-data banner.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Settings from '../islands/Settings.tsx';
import MiniPlayer from '../islands/MiniPlayer.tsx';
import Bidi from '../components/Bidi.astro';
import { dev, record, audioOn } from '../lib/data';
import { t, homePath, privacyPath, type Lang } from '../../core/strings.ts';
// inPlace (RQ-006 v1.3, D-126 1A): pages a reader can open (A1: home, index, reader, Tafseer,
// privacy, 404) change in place with Astro's client router (src/site/client/nav.ts), so a recitation
// keeps playing; they carry the rifq-page marker the router checks before placing a page in the tab
// (AC72). Development pages pass false: always full loads, no mini-player (A1, AC66).
interface Props { lang: Lang; title: string; alt: string; wide?: boolean; inPlace?: boolean }
const { lang, title, alt, wide = false, inPlace = true } = Astro.props;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <!-- Browsers fetch the manifest without credentials unless asked; use-credentials sends the
         test site's Basic auth with it, so the gate stays closed to everyone else. -->
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <!-- D-069: the Quran font is fetched early. crossorigin is required for font preloads, even on
         the same origin; anonymous mode still sends same-origin credentials (the test site gate). -->
    <link rel="preload" href="/fonts/noto-naskh-arabic/NotoNaskhArabic-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {inPlace && <meta name="rifq-page" content="a1" />}
    {inPlace && <ClientRouter fallback="swap" />}
    {inPlace && <script>import '../client/nav.ts';</script>}
    <script is:inline>(function(){try{var v=JSON.parse(localStorage.getItem('rifq.settings')||'{}'),d=document.documentElement;if(v&&v.dark===true)d.classList.add('dark');var z=[1.25,1.5,1.75,2,2.5];if(v&&z.indexOf(v.size)>=0)d.style.setProperty('--ayah-size',v.size+'rem')}catch(e){}})();</script>
  </head>
  <!-- wide: home, the surah index and reader pages use the wider tablet and desktop layout. -->
  <body class={wide ? 'wide' : undefined}>
    {dev && <p class="banner" role="note" data-dev-banner><Bidi text={t(lang, 'devBanner')} lang={lang} /></p>}
    <a class="skip" href="#content">{t(lang, 'skip')}</a>
    <header class="site-header">
      <a class="brand" href={homePath(lang)}><svg class="brand-mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path class="brand-arch-outer" d="M6 27V14a10 10 0 0120 0v13" fill="none" stroke-width="2.2" stroke-linecap="round"/><path class="brand-arch-inner" d="M11 27V16a5 5 0 0110 0v11" fill="none" stroke-width="2.2" stroke-linecap="round"/></svg>{t(lang, 'siteName')}</a>
      <a id="lang-switch" href={alt} lang={other} hreflang={other} aria-label={t(lang, 'otherLangLabel')}>{t(lang, 'otherLang')}</a>
      <Settings lang={lang} client:idle />
    </header>
    <main id="content" tabindex="-1"><slot /></main>
    {/* RQ-006 v1.3: the one audio element of the tab and the mini-player, carried into every page
        changed in place (transition:persist), after the main content and before the footer (P-12). */}
    {inPlace && audioOn && <audio data-audio preload="none" transition:persist="rifq-audio"></audio>}
    {inPlace && audioOn && <MiniPlayer lang={lang} dev={dev} client:idle transition:persist="rifq-mini" />}
    <footer class="site-footer">
      <details data-source-details>
        <summary>{t(lang, 'source')}</summary>
        <dl dir="ltr">
          <dt>{t(lang, 'sourceName')}</dt><dd data-source-name>{record.name}</dd>
          <dt>{t(lang, 'sourceEdition')}</dt><dd data-source-edition>{record.edition}</dd>
          <dt>{t(lang, 'sourceStatus')}</dt><dd data-source-status>{record.status}</dd>
          <dt><Bidi text={t(lang, 'sourceSha')} lang={lang} /></dt><dd data-source-sha><code>{record.sha256}</code></dd>
        </dl>
      </details>
      <!-- D-099: every page links to the privacy page. -->
      <p class="footer-links"><a href={privacyPath(lang)} data-privacy-link>{t(lang, 'privacyLink')}</a></p>
    </footer>
  </body>
</html>
