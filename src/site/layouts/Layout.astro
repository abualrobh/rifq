---
// Every page uses this layout, so every page shows the source details (RQ-001 AC6) and, in
// development mode, the unverified-data banner.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Settings from '../islands/Settings.tsx';
import Bidi from '../components/Bidi.astro';
import TabBar, { type Tab } from '../components/TabBar.astro';
import { dev, record, audioOn } from '../lib/data';
import { t, homePath, privacyPath, searchPath, type Lang } from '../../core/strings.ts';
// inPlace (RQ-006 v1.3, D-126 1A): pages a reader can open (A1: home, index, reader, Tafseer,
// privacy, 404) change in place with Astro's client router (src/site/client/nav.ts), so a recitation
// keeps playing; they carry the rifq-page marker the router checks before placing a page in the tab
// (AC72). Development pages pass false: always full loads, no mini-player (A1, AC66).
// notFound: RIFQ's own 404 page, which answers with status 404; its second marker lets the router
// place it in the tab too (QA v26 FIND-G: Back or Forward to it keeps the recitation playing).
// RQ-008 stage 1 (kit v37): tab: the tab bar item of this page (AC2; none on privacy and 404).
// textSize: the header keeps the text-size control on reader and Tafseer pages only (D-193 A).
// The header has no night button (Hamzeh, AC72) and no language link (D-181 C): the light/dark
// switch and the interface language are on the Settings screen, and the Tafseer page has its own
// language link (AC75). `alt` (the same page in the other language) is kept for callers that use it.
// Kit v39 (RQ-008 stage 3, AC50): reader pages pass `reader`. Their header shows Back (P-18), the
// surah name as the page heading with the line "Surah {s} · {n} ayat · Juz {j}" (P-19), a Go to
// button that opens the Go to screen, and the text-size button (D-193 A); no brand, no night button,
// no language link. Back goes to the previous RIFQ page in this tab (client/nav.ts), else Home.
type Reader = { s: number; name: string; meta: string };
interface Props { lang: Lang; title: string; alt: string; wide?: boolean; inPlace?: boolean; notFound?: boolean; tab?: Tab; textSize?: boolean; reader?: Reader }
const { lang, title, wide = false, inPlace = true, notFound = false, tab, textSize = false, reader } = Astro.props;
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <!-- Browsers fetch the manifest without credentials unless asked; use-credentials sends the
         test site's Basic auth with it, so the gate stays closed to everyone else. -->
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <!-- D-069: the Quran font is fetched early. crossorigin is required for font preloads, even on
         the same origin; anonymous mode still sends same-origin credentials (the test site gate). -->
    <link rel="preload" href="/fonts/noto-naskh-arabic/NotoNaskhArabic-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {/* Kit v43 (FIND-CJ, D-279 (4)): the interface font (Tajawal, D-102) of the page's language is
        fetched early too, so the header is usually laid out in it at the first paint and does not
        change height when it arrives (seen at 320 px and 200% text). Same files the page already
        uses; only the start of the fetch moves. */}
    {(lang === 'ar' ? ['arabic-400', 'arabic-500', 'arabic-700', 'latin-400', 'latin-500', 'latin-700'] : ['latin-400', 'latin-500', 'latin-700']).map((f) => <link rel="preload" href={`/fonts/tajawal/tajawal-${f}-normal.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />)}
    {inPlace && <meta name="rifq-page" content="a1" />}
    {inPlace && notFound && <meta name="rifq-not-found" content="1" />}
    {inPlace && <ClientRouter fallback="swap" />}
    {inPlace && <script>import '../client/nav.ts';</script>}
    <script is:inline>(function(){try{var v=JSON.parse(localStorage.getItem('rifq.settings')||'{}'),d=document.documentElement;if(v&&v.dark===true)d.classList.add('dark');var z=[1.25,1.5,1.75,2,2.5];if(v&&z.indexOf(v.size)>=0)d.style.setProperty('--ayah-size',v.size+'rem');var w=JSON.parse(localStorage.getItem('rifq.saves')||'{}');if(w&&w.v===1){if(w.l)d.classList.add('rifq-last');if(w.b&&w.b.length)d.classList.add('rifq-bm')}}catch(e){}try{var r=parseFloat(getComputedStyle(d).fontSize)||16;if(innerHeight/r<40)d.classList.add('rifq-tall-text')}catch(e){}})();</script>
    {/* RQ-008 AC93 (kit v37): the early script above also marks whether a last position and
        bookmarks are saved (rifq-last, rifq-bm: yes/no only, nothing is read out or sent), so the
        home page keeps room for its continue card and bookmark cards before its island loads.
        Kit v43 (D-279 (4), QA v40 FIND-CJ, reopens D-262): it also sets the large-text class
        (html.rifq-tall-text: the screen is less than 40 lines of text tall, the same rule and number
        as client/tabbar.ts, which keeps it up to date afterwards), so the page is laid out at large
        text from its first paint and does not jump when the module script runs. Nothing is read
        from storage for it and nothing is stored or sent. The script is allowed by its SHA-256 hash
        (scripts/headers.ts), never by 'unsafe-inline'. */}
  </head>
  <!-- wide: home, the surah index and reader pages use the wider tablet and desktop layout. -->
  <body class={wide ? 'wide' : undefined}>
    {dev && <p class="banner" role="note" data-dev-banner><Bidi text={t(lang, 'devBanner')} lang={lang} /></p>}
    <a class="skip" href="#content">{t(lang, 'skip')}</a>
    <header class={reader ? 'site-header reader-head' : 'site-header'}>
      {reader && <a class="btn icon-btn rh-back" href={homePath(lang)} aria-label={t(lang, 'back')} title={t(lang, 'back')} data-reader-back><svg class="rh-dir" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>}
      {reader && <div class="rh-titles"><h1 class="surah-title rh-title"><bdi dir={lang === 'ar' ? 'rtl' : 'ltr'} data-sn>{reader.s}.</bdi>{' '}<span lang={lang === 'ar' ? 'ar' : 'en'}>{reader.name}</span></h1><p class="rh-meta" data-reader-meta>{reader.meta}</p></div>}
      <a class={reader ? 'brand brand-hidden' : 'brand'} href={homePath(lang)}><svg class="brand-mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path class="brand-arch-outer" d="M6 27V14a10 10 0 0120 0v13" fill="none" stroke-width="2.2" stroke-linecap="round"/><path class="brand-arch-inner" d="M11 27V16a5 5 0 0110 0v11" fill="none" stroke-width="2.2" stroke-linecap="round"/></svg><span class="brand-name">{t(lang, 'siteName')}</span></a>
      {inPlace && <TabBar lang={lang} tab={tab} variant="top" />}
      {reader && <a class="btn icon-btn rh-goto" href={searchPath(lang)} aria-label={t(lang, 'goTo')} title={t(lang, 'goTo')} data-reader-goto><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></a>}
      <Settings lang={lang} size={textSize} client:idle />
    </header>
    <main id="content" tabindex="-1"><slot /></main>
    {/* RQ-006 v1.3: the one audio element of the tab and the mini-player, carried into every page
        changed in place (transition:persist), after the main content and before the footer (P-12). */}
    {inPlace && audioOn && <audio data-audio preload="none" transition:persist="rifq-audio"></audio>}
    {inPlace && audioOn && <div class="mini-root" data-mini-root data-dev={dev ? '1' : '0'} transition:persist="rifq-mini"></div>}
    {inPlace && audioOn && <script>import '../client/mini-mount.ts';</script>}
    {/* RQ-008 AC1, P-1: the phone tab bar comes after the content and the mini-player in reading
        and tab order, and before the footer; it is fixed at the bottom of the screen. */}
    {inPlace && <TabBar lang={lang} tab={tab} variant="bottom" />}
    {inPlace && <script>import '../client/tabbar.ts';</script>}
    <footer class="site-footer">
      <details data-source-details>
        <summary>{t(lang, 'source')}</summary>
        <dl dir="ltr">
          <dt>{t(lang, 'sourceName')}</dt><dd data-source-name>{record.name}</dd>
          <dt>{t(lang, 'sourceEdition')}</dt><dd data-source-edition>{record.edition}</dd>
          <dt>{t(lang, 'sourceStatus')}</dt><dd data-source-status>{record.status}</dd>
          <dt><Bidi text={t(lang, 'sourceSha')} lang={lang} /></dt><dd data-source-sha><code>{record.sha256}</code></dd>
        </dl>
      </details>
      <!-- D-099: every page links to the privacy page. -->
      <p class="footer-links"><a href={privacyPath(lang)} data-privacy-link>{t(lang, 'privacyLink')}</a></p>
    </footer>
  </body>
</html>
